# Настройки для запуска в Docker.
# Скопируйте файл в .env.docker и замените change-me на свои значения.

# Пароль базы данных PostgreSQL в Docker (тот же пароль — в DATABASE_URL ниже)
DB_PASSWORD=change-me

# Настройки сервера
DEBUG=false
SECRET_KEY=change-me-to-long-random-string
DATABASE_URL=postgres://codemarket:change-me@db:5432/codemarket
SITE_URL=http://127.0.0.1:8000

# Оплата и GitHub в демо-режиме, интернет не нужен
PAYMENT_PROVIDER=fake
GITHUB_MODE=fake
GITHUB_ORG=codemarket-demo
